# Required: OpenAI API key for receipt extraction
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Receipt format (defaults used if not set)
# Currency/unit symbol shown on receipt (e.g., TK, BDT, USD)
MONEY_UNIT=USD
# Name of the sender (used only in the extraction prompt)
SENDER_NAME=ABC Inc.
# Label for main amount as it appears on the receipt (default: Amount)
AMOUNT_LABEL=Final Amount
# Label for additional amount as it appears on the receipt (default: Additional Amount). Leave empty to skip.
ADDITIONAL_AMOUNT_LABEL=Bonus
